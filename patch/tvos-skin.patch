+package com.gathin.tvhome;
+
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+
+/**
+ * A pane of clear glass: the tile's own surface, drawn over whatever is behind it.
+ *
+ * It is deliberately not a picture. Sampling the wallpaper into the pane seemed the obvious way to show the
+ * scene through the glass, but a tile that draws the wallpaper cannot keep up with everything in front of the
+ * wallpaper — the cinematic scrim, the top fade — so it comes out lighter than its surroundings and the pane
+ * stops reading as glass at all. Leaving the pane empty does: the screen behind it is already the exact picture,
+ * and the pane only has to add what glass adds — a thin body, a specular sheen, a bright lip and a dark line
+ * just inside it where the thickness turns away.
+ */
+final class GlassPlateDrawable extends Drawable {
+
+    private final View host;
+    private final float density;
+    private float radius;
+
+    private final Paint body = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint sheen = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint lip = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint shade = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint tint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint inner = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+
+    /** The app's own colour, kept as a hint so the pane still reads as that app; 0 for none. */
+    private int baseColor;
+    /** 0 at rest, 1 focused: the pane is always glass, focus only brightens it and wakes its edge. */
+    private float emphasis;
+    private int drawableAlpha = 255;
+
+    GlassPlateDrawable(View host, float radius) {
+        this.host = host;
+        this.radius = radius;
+        this.density = host.getResources().getDisplayMetrics().density;
+        lip.setStyle(Paint.Style.STROKE);
+        lip.setStrokeWidth(1.3f * density);
+        inner.setStyle(Paint.Style.STROKE);
+        inner.setStrokeWidth(1f * density);
+    }
+
+    void setRadius(float radius) {
+        this.radius = radius;
+        invalidateSelf();
+    }
+
+    /** The colour of the app's tile, seen through the glass; 0 for none (a poster or banner tile). */
+    void setBaseColor(int color) {
+        this.baseColor = color;
+        invalidateSelf();
+    }
+
+    /** 0 at rest, 1 focused. */
+    void setEmphasis(float value) {
+        if (Math.abs(value - emphasis) < 0.01f) return;
+        emphasis = Math.max(0f, Math.min(1f, value));
+        invalidateSelf();
+    }
+
+    @Override
+    public void setBounds(int left, int top, int right, int bottom) {
+        super.setBounds(left, top, right, bottom);
+        rect.set(left, top, right, bottom);
+        float h = rect.height();
+        body.setShader(new LinearGradient(0, top, 0, bottom, 0x1CFFFFFF, 0x0AFFFFFF, Shader.TileMode.CLAMP));
+        sheen.setShader(new LinearGradient(0, top, 0, top + h * 0.48f, 0x30FFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
+        // Light comes from above the screen: the top lip is bright, the sides fade, the bottom is barely there.
+        lip.setShader(new LinearGradient(0, top, 0, bottom, 0xF0FFFFFF, 0x2EFFFFFF, Shader.TileMode.CLAMP));
+        // Just inside the lip, a dark line fakes the pane's thickness where it turns away from the light.
+        shade.setShader(new LinearGradient(0, top, 0, bottom, 0x00FFFFFF, 0x33000000, Shader.TileMode.CLAMP));
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        float top = rect.top, bottom = rect.bottom;
+        if (bottom <= top) return;
+        float a = drawableAlpha / 255f;
+
+        // A hint of the app's colour, not a fill: enough that a red app still reads as red through the pane.
+        if (baseColor != 0) {
+            tint.setColor(baseColor);
+            tint.setAlpha(Math.round((22 + 40 * emphasis) * a));
+            canvas.drawRoundRect(rect, radius, radius, tint);
+        }
+
+        body.setAlpha(Math.round((190 + 65 * emphasis) * a));
+        canvas.drawRoundRect(rect, radius, radius, body);
+
+        canvas.save();
+        canvas.clipRect(rect.left, top, rect.right, top + rect.height() * 0.48f);
+        sheen.setAlpha(Math.round((165 + 90 * emphasis) * a));
+        canvas.drawRoundRect(rect, radius, radius, sheen);
+        canvas.restore();
+
+        float inset = 1.5f * density;
+        shade.setAlpha(Math.round((90 + 120 * emphasis) * a));
+        canvas.drawRoundRect(rect.left + inset, top + inset, rect.right - inset, bottom - inset,
+                Math.max(0f, radius - inset), Math.max(0f, radius - inset), shade);
+
+        lip.setAlpha(Math.round((130 + 110 * emphasis) * a));
+        canvas.drawRoundRect(rect, radius, radius, lip);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        drawableAlpha = alpha;
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(android.graphics.ColorFilter colorFilter) {
+        // The pane is transparent by design: no filter is applied.
+    }
+
+    @Override
+    public int getOpacity() {
+        return android.graphics.PixelFormat.TRANSLUCENT;
+    }
+}
